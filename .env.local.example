# Kopjoje si .env.local dhe plotëso vlerat.
#   cp .env.local.example .env.local

# ---------------------------------------------------------------------------
# Supabase — E DETYRUESHME
# Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Nuk duhet service_role key — aplikacioni nuk e përdor kurrë.

# ---------------------------------------------------------------------------
# Email — OPSIONALE (https://resend.com, 3.000 email/muaj falas)
#
# Përdoret për të njoftuar pronarin kur admini i pezullon biznesin.
# Pa këto, email-et vetëm shkruhen në log dhe ASNJË veprim nuk bllokohet —
# pezullimi ndodh gjithsesi, thjesht pa njoftim.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxx

# Nisësi. Për provë, Resend lejon onboarding@resend.dev pa domen të verifikuar.
# Për prodhim: verifiko domenin dhe përdor p.sh. "Rezervo.al <njoftime@rezervo.al>"
EMAIL_FROM=Rezervo.al <onboarding@resend.dev>
