# Kopjoje si .env.local dhe plotëso vlerat.
#   cp .env.local.example .env.local

# ---------------------------------------------------------------------------
# Supabase — E DETYRUESHME
# Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Nuk duhet service_role key — aplikacioni nuk e përdor kurrë.

# ---------------------------------------------------------------------------
# Email — OPSIONALE
#
# Përdoret për të njoftuar pronarin kur admini i pezullon biznesin.
# Pa asnjë çelës, email-et vetëm shkruhen në log dhe ASNJË veprim nuk bllokohet —
# pezullimi ndodh gjithsesi, thjesht pa njoftim.
#
# Vendos VETËM njërin. Aplikacioni e zgjedh vetë provider-in sipas çelësit
# që gjen; s'ka nevojë për konfigurim tjetër.
# ---------------------------------------------------------------------------

# Opsioni 1 — Brevo: 300 email/ditë falas (~9.000/muaj), serverë në BE.
#   Më bujari nga të gjithë dhe pa kartë krediti. https://brevo.com
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxx

# Opsioni 2 — Resend: 3.000 email/muaj, 100/ditë. https://resend.com
#   Për provë lejon onboarding@resend.dev pa verifikuar domen.
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Nisësi. Për prodhim verifiko domenin tënd te provider-i dhe përdor një adresë
# të tijën, p.sh. "Rezervo.al <njoftime@rezervo.al>".
EMAIL_FROM=Rezervo.al <onboarding@resend.dev>

# Opsionale: detyro një provider edhe kur ka disa çelësa ("resend" | "brevo" | "none").
# EMAIL_PROVIDER=brevo
